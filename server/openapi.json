{
  "openapi": "3.1.0",
  "info": {
    "title": "Prachaar API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "Brand": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "website": {
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "defaultLanguage": {
            "type": "string"
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "archived"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "website",
          "country",
          "timezone",
          "currency",
          "defaultLanguage",
          "languages",
          "status",
          "createdAt"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "BrandCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "website": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048,
            "format": "uri"
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "defaultLanguage": {
            "type": "string",
            "minLength": 2,
            "maxLength": 10
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 10
            },
            "minItems": 1,
            "maxItems": 10
          }
        },
        "required": [
          "name"
        ]
      },
      "BrandUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "website": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048,
            "format": "uri"
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "defaultLanguage": {
            "type": "string",
            "minLength": 2,
            "maxLength": 10
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 10
            },
            "minItems": 1,
            "maxItems": 10
          }
        }
      },
      "Competitor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "direct",
              "indirect",
              "aspirational"
            ]
          },
          "site": {
            "type": [
              "string",
              "null"
            ]
          },
          "handles": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "adLibraryUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "site",
          "handles",
          "adLibraryUrl",
          "priority"
        ]
      },
      "CompetitorCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "direct",
              "indirect",
              "aspirational"
            ]
          },
          "site": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048,
            "format": "uri"
          },
          "handles": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 200
            }
          },
          "adLibraryUrl": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048,
            "format": "uri"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "CompetitorUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "direct",
              "indirect",
              "aspirational"
            ]
          },
          "site": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048,
            "format": "uri"
          },
          "handles": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 200
            }
          },
          "adLibraryUrl": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048,
            "format": "uri"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "Source": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "brandId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "page",
              "upload"
            ]
          },
          "uri": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "checksum": {
            "type": "string"
          },
          "capturedAt": {
            "type": "string"
          },
          "trust": {
            "type": "string",
            "enum": [
              "owner",
              "brand_site",
              "external"
            ]
          },
          "meta": {
            "type": "object",
            "additionalProperties": {}
          },
          "hasText": {
            "type": "boolean"
          },
          "downloadUrl": {
            "type": "string",
            "description": "Short-lived. Anything but a raster image downloads as an attachment."
          }
        },
        "required": [
          "id",
          "brandId",
          "kind",
          "uri",
          "mime",
          "checksum",
          "capturedAt",
          "trust",
          "meta",
          "hasText",
          "downloadUrl"
        ]
      },
      "UploadCreated": {
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "uploadUrl": {
            "type": "string",
            "description": "PUT the file here with the same Content-Type, then call complete."
          }
        },
        "required": [
          "source",
          "uploadUrl"
        ]
      },
      "UploadCreate": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "mime": {
            "type": "string",
            "example": "application/pdf"
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "filename",
          "mime",
          "bytes"
        ]
      },
      "Costs": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "example": "2026-11"
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "cap": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Money"
              },
              {
                "description": "Decimal strings, never floats."
              }
            ]
          },
          "remaining": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Money"
              },
              {
                "description": "What the tenant may still spend this month, across all its brands."
              }
            ]
          },
          "runs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CostRun"
            }
          }
        },
        "required": [
          "month",
          "total",
          "cap",
          "remaining",
          "runs"
        ]
      },
      "Money": {
        "type": "object",
        "properties": {
          "usd": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$",
            "example": "6.0000"
          },
          "npr": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$",
            "example": "930.48"
          }
        },
        "required": [
          "usd",
          "npr"
        ],
        "description": "This brand's AI spend this month (UTC)."
      },
      "CostRun": {
        "type": "object",
        "properties": {
          "runType": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "calls": {
            "type": "integer"
          },
          "failedCalls": {
            "type": "integer"
          },
          "inputTokens": {
            "type": "integer"
          },
          "outputTokens": {
            "type": "integer"
          },
          "cost": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Money"
              },
              {
                "description": "Decimal strings, never floats."
              }
            ]
          },
          "lastAt": {
            "type": "string"
          }
        },
        "required": [
          "runType",
          "runId",
          "calls",
          "failedCalls",
          "inputTokens",
          "outputTokens",
          "cost",
          "lastAt"
        ]
      },
      "AuditEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "objectType": {
            "type": "string"
          },
          "objectId": {
            "type": "string"
          },
          "objectVersion": {
            "type": [
              "integer",
              "null"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "ok",
              "denied",
              "failed"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "actor",
          "action",
          "objectType",
          "objectId",
          "objectVersion",
          "result",
          "reason",
          "createdAt"
        ]
      }
    },
    "parameters": {}
  },
