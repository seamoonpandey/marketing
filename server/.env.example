# Copy to .env for `pnpm dev`. Tests read the same names (vitest.config.ts holds local defaults).
# Production sets NODE_ENV=production: the API then refuses to start while a database URL, an S3 value or the model
# key is unset or still a development value below, or AI_MODEL is mock (src/config.ts).
PORT=8000
# The app role: no BYPASSRLS, no UPDATE or DELETE on audit_events.
DATABASE_URL=postgres://marketing_app:marketing_app@127.0.0.1:5436/marketing
# The owner role: runs migrations and creates test databases.
DATABASE_ADMIN_URL=postgres://marketing:marketing@127.0.0.1:5436/marketing
DBOS_SYSTEM_DATABASE_URL=postgres://marketing:marketing@127.0.0.1:5436/marketing_dbos
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=marketing-dev
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
# `mock` answers from src/ai/mock.ts and makes no paid call.
AI_MODEL=mock
ANTHROPIC_API_KEY=
# For a real model at no cost while testing: AI_MODEL=openrouter:nvidia/nemotron-3.5-super-vl:free with a key here.
# Free models are rate-limited and weaker than Claude; src/ai/registry.ts lists the models the gateway knows.
OPENROUTER_API_KEY=
AI_MONTHLY_CAP_NPR=5000
USD_NPR=155.08
TENANT_SLUG=xenextech
# Set by pm2 for each cluster instance (0, 1, …); leave it unset for a single process. Instance n is DBOS executor
# api-<n> and recovers only its own unfinished workflows (unset: executor `local`). Two processes must never share an
# executor ID, or each recovers, and runs again, the workflows the other is running.
# NODE_APP_INSTANCE=
# Optional. The most one scheduled competitor check may spend in NPR, read straight from the environment (default 150).
# RESEARCH_RUN_CAP_NPR=150
# Optional. pino level (default info; silent under vitest).
# LOG_LEVEL=info
