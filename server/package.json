{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "openapi": "node scripts/openapi.ts",
    "openapi:check": "node scripts/openapi.ts --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env scripts/db-reset.ts",
    "seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "e2e:server": "node scripts/e2e-server.ts"
  },
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.110",
    "@aws-sdk/client-s3": "3.1178.0",
    "@aws-sdk/s3-request-presigner": "3.1178.0",
    "@dbos-inc/dbos-sdk": "5.7.0",
    "@hono/node-server": "2.1.11",
    "@hono/zod-openapi": "1.6.3",
    "ai": "7.0.183",
    "diff": "^9.0.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.23",
    "mammoth": "^1.13.0",
    "node-html-parser": "^9.0.7",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "robots-parser": "^3.1.1",
    "sharp": "^0.35.5",
    "unpdf": "^2.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
